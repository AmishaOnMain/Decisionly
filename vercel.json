{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run client:build",
  "outputDirectory": "dist/client",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api?match=$1"
    },
    {
      "source": "/((?!api).*)",
      "destination": "/index.html"
    }
  ]
}
