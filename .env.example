# Decisionly Environment Configuration
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000

# PostgreSQL Database Connection
# Supports standard PostgreSQL, Neon, Supabase, or Replit Postgres
# When empty in development, a local persistent JSON/SQLite store is used automatically for seamless setup
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/decisionly

# Session Secret (random 32+ char string)
SESSION_SECRET=decisionly-super-secure-session-secret-change-in-production-2026

# Groq API Configuration for Decision Intelligence
# Get your API key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
# Configurable model - options include: llama-3.3-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768
GROQ_MODEL=llama-3.3-70b-versatile

# Optional Cookie & Proxy Settings
COOKIE_SECURE=false
TRUST_PROXY=false
